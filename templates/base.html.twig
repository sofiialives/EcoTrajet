<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Eco Trajet{% endblock %} — Eco Trajet</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 36 36%22><rect width=%2236%22 height=%2236%22 rx=%2211%22 fill=%22%23A3E635%22/><path d=%22M10 27c0-7 9-4 9-11%22 stroke=%22%230A0C0B%22 stroke-width=%222.6%22 stroke-linecap=%22round%22 fill=%22none%22/><circle cx=%2210%22 cy=%2227%22 r=%222.4%22 fill=%22%230A0C0B%22/><path d=%22M19 16c-.4-4.6 2.4-7.6 7.4-8 .4 5-2.4 7.8-7.4 8Z%22 fill=%22%230A0C0B%22/></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
        {# Bootstrap 5 (base) + thème Eco Trajet (surcharge, cf. maquette Figma) #}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% set route = app.request.attributes.get('_route') %}

        {% block entete %}
            <header class="entete">
                <div class="entete__inner">
                    <a href="{{ path('app_accueil') }}" class="logo">
                        <svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true">
                            <rect width="36" height="36" rx="11" fill="#A3E635"/>
                            <path d="M10 27c0-7 9-4 9-11" stroke="#0A0C0B" stroke-width="2.6" stroke-linecap="round"/>
                            <circle cx="10" cy="27" r="2.4" fill="#0A0C0B"/>
                            <path d="M19 16c-.4-4.6 2.4-7.6 7.4-8 .4 5-2.4 7.8-7.4 8Z" fill="#0A0C0B"/>
                        </svg>
                        <span>Eco<span class="logo__accent">Trajet</span></span>
                    </a>

                    <nav class="nav-principale" aria-label="Navigation principale">
                        <a href="{{ path('app_accueil') }}" class="{{ route == 'app_accueil' ? 'actif' }}">Accueil</a>
                        <a href="{{ path('app_trajet_rechercher') }}" class="{{ route == 'app_trajet_rechercher' ? 'actif' }}">Rechercher un trajet</a>
                        <a href="{{ path('app_trajet_creer') }}" class="{{ route == 'app_trajet_creer' ? 'actif' }}">Créer un trajet</a>
                        <a href="{{ path('app_mes_trajets') }}" class="{{ route == 'app_mes_trajets' ? 'actif' }}">Mes trajets</a>
                    </nav>

                    {% if app.user %}
                        <details class="menu-avatar">
                            <summary>
                                <span class="avatar">
                                    {% if app.user.photo %}
                                        <img src="{{ asset('uploads/avatars/' ~ app.user.photo) }}" alt="Photo de profil">
                                    {% else %}
                                        {{ app.user.initiales }}
                                    {% endif %}
                                </span>
                            </summary>
                            <div class="menu-avatar__liste">
                                <a href="{{ path('app_profil') }}">Mon profil</a>
                                <a href="{{ path('app_mes_trajets') }}">Mes trajets</a>
                                <a href="{{ path('app_mes_trajets', {onglet: 'reservations'}) }}">Mes réservations</a>
                                <a href="{{ path('app_deconnexion') }}" class="danger">Déconnexion</a>
                            </div>
                        </details>
                    {% else %}
                        <a href="{{ route == 'app_connexion' ? path('app_inscription') : path('app_connexion') }}" class="btn btn--fantome btn--petit">
                            {{ route == 'app_connexion' ? 'Créer un compte' : 'Se connecter' }}
                        </a>
                    {% endif %}
                </div>
            </header>
        {% endblock %}

        {% block corps_conteneur %}
            <main class="conteneur">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alerte alerte--{{ type == 'erreur' ? 'erreur' : (type == 'avertissement' ? 'avertissement' : 'succes') }}" role="alert">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block corps %}{% endblock %}
            </main>
        {% endblock %}

        {% if app.user %}
            <nav class="nav-mobile" aria-label="Navigation mobile">
                <a href="{{ path('app_accueil') }}" class="{{ route == 'app_accueil' ? 'actif' }}">
                    <svg viewBox="0 0 24 24" fill="none"><path d="m4 11 8-7 8 7v9a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1v-9Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                    Accueil
                </a>
                <a href="{{ path('app_trajet_rechercher') }}" class="{{ route == 'app_trajet_rechercher' ? 'actif' }}">
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    Rechercher
                </a>
                <a href="{{ path('app_trajet_creer') }}" class="{{ route == 'app_trajet_creer' ? 'actif' }}">
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    Créer
                </a>
                <a href="{{ path('app_mes_trajets') }}" class="{{ route == 'app_mes_trajets' ? 'actif' }}">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M6 19c0-5 12-3 12-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="6" cy="19" r="2" fill="currentColor"/><circle cx="18" cy="7" r="2.6" stroke="currentColor" stroke-width="1.8"/></svg>
                    Mes trajets
                </a>
                <a href="{{ path('app_profil') }}" class="{{ route == 'app_profil' ? 'actif' }}">
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M4 20c1.5-3.5 4.5-5 8-5s6.5 1.5 8 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    Profil
                </a>
            </nav>
        {% endif %}

        <script>
            // Afficher / masquer le mot de passe (icône œil).
            document.addEventListener('click', function (e) {
                const bouton = e.target.closest('[data-bascule-mdp]');
                if (!bouton) return;
                const champ = bouton.parentElement.querySelector('input');
                if (!champ) return;
                const visible = champ.type === 'text';
                champ.type = visible ? 'password' : 'text';
                bouton.setAttribute('aria-label', visible ? 'Afficher le mot de passe' : 'Masquer le mot de passe');
            });
        </script>
    </body>
</html>
