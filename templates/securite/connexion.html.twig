{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block corps_conteneur %}
    <main class="page-auth">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alerte alerte--{{ type == 'erreur' ? 'erreur' : 'succes' }}" role="alert">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="carte">
            <h1>Connexion</h1>
            <p class="sous-titre">Ravi de vous revoir sur Eco Trajet.</p>

            {% if erreur %}
                <div class="alerte alerte--erreur" role="alert">
                    <strong>Erreur de connexion</strong>
                    <p>Adresse e-mail ou mot de passe incorrect.</p>
                </div>
            {% endif %}

            <form method="post" data-turbo="false">
                <div class="champ">
                    <label for="email" class="form-label fw-semibold">Adresse e-mail</label>
                    <input type="email" id="email" name="email" value="{{ dernier_email }}" class="form-control"
                           placeholder="prenom.nom@univ.fr" autocomplete="email" required autofocus>
                </div>

                <div class="champ">
                    <label for="mot_de_passe" class="form-label fw-semibold">Mot de passe</label>
                    <div class="champ-mdp">
                        <input type="password" id="mot_de_passe" name="mot_de_passe" class="form-control"
                               placeholder="••••••••••" autocomplete="current-password" required>
                        <button type="button" class="oeil" data-bascule-mdp aria-label="Afficher le mot de passe">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" stroke="currentColor" stroke-width="1.8"/>
                                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="ligne-options">
                    <label class="form-check d-flex align-items-center gap-2">
                        <input type="checkbox" name="se_souvenir" class="form-check-input">
                        <span class="form-check-label">Se souvenir de moi</span>
                    </label>
                    <a href="{{ path('app_mot_de_passe_oublie') }}">Mot de passe oublié ?</a>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn btn--primaire btn--large">Se connecter</button>
            </form>

            <p class="lien-pied">
                Pas encore de compte ? <a href="{{ path('app_inscription') }}">Créer un compte</a>
            </p>
        </div>
    </main>
{% endblock %}
