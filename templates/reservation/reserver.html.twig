{% extends 'base.html.twig' %}

{% block title %}Réservation{% endblock %}

{% block corps %}
    <div class="page-auth" style="padding: 0; max-width: 560px;">
        <div class="carte">
            <h1 style="font-size: 24px;">Confirmer votre réservation</h1>
            <p class="sous-titre">Vérifiez les informations avant de confirmer.</p>

            {{ form_start(form, {attr: {'data-turbo': 'false'}}) }}
                <div class="recap" style="margin-bottom: 18px;">
                    <dl>
                        <div class="recap__ligne"><dt>Trajet</dt><dd>{{ trajet.itineraire }}</dd></div>
                        <div class="recap__ligne"><dt>Conducteur</dt><dd>{{ trajet.conducteur.nomCourt }}</dd></div>
                        <div class="recap__ligne"><dt>Date</dt><dd>{{ trajet.date|date_fr_longue }}</dd></div>
                        <div class="recap__ligne"><dt>Heure de départ</dt><dd>{{ trajet.heure|date('H\\hi') }}</dd></div>
                        <div class="recap__ligne"><dt>Point de rendez-vous</dt><dd>{{ trajet.pointRendezVous }}</dd></div>
                        <div class="recap__ligne"><dt>Prix par place</dt><dd>{{ trajet.prixParPlace|number_format(2, ',', ' ') }} €</dd></div>
                        <div class="recap__ligne"><dt>Places disponibles</dt><dd>{{ trajet.placesRestantes }}</dd></div>
                    </dl>
                </div>

                <div class="champ">
                    {{ form_label(form.nombrePlaces, 'Nombre de places', {
                        label_attr: {class: 'form-label fw-semibold'}
                    }) }}
                    {{ form_widget(form.nombrePlaces, {
                        attr: {class: 'form-control'}
                    }) }}
                    {{ form_errors(form.nombrePlaces) }}
                </div>

                <div class="recap recap__total" style="margin-bottom: 18px;">
                    <div class="recap__ligne recap__total">
                        <dt>Prix total</dt>
                        <dd data-prix-total data-prix-place="{{ trajet.prixParPlace }}">
                            {{ trajet.prixParPlace|number_format(2, ',', ' ') }} €
                        </dd>
                    </div>
                </div>

                <p class="note-petite" style="margin: 0 0 18px;">
                    Le paiement s’effectue directement auprès du conducteur.
                </p>

                <button type="submit" class="btn btn--primaire btn--large">Confirmer la réservation</button>
            {{ form_end(form) }}

            <p class="lien-pied">
                <a href="{{ path('app_trajet_details', {id: trajet.id}) }}">Annuler et revenir au trajet</a>
            </p>
        </div>
    </div>

    <script>
        // Prix total = places × prix par place, mis à jour en direct.
        (function () {
            const sortie = document.querySelector('[data-prix-total]');
            const champ = document.querySelector('input[type="number"]');
            if (!sortie || !champ) return;
            const prixPlace = parseFloat(sortie.dataset.prixPlace);
            const maj = () => {
                const n = Math.max(1, parseInt(champ.value || '1', 10));
                sortie.textContent = (n * prixPlace).toLocaleString('fr-FR', {minimumFractionDigits: 2}) + ' €';
            };
            champ.addEventListener('input', maj);
            maj();
        })();
    </script>
{% endblock %}
